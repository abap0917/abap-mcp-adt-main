# ============================================================================
# MCP ABAP ADT — DEV 系统环境文件模板 (On-Premise + Basic Auth 示例)
# 用法: 复制为 dev.env,填入你的开发系统信息。
#   copy dev.env.example dev.env     (Windows)
#   cp dev.env.example dev.env       (macOS / Linux)
# 注意: 本文件是占位值,直接使用无法连接 SAP。不要提交真实的 dev.env 到 git!
# ============================================================================

# --- SAP 系统连接 (必填) ---
# On-Premise 开发系统示例
SAP_URL=http://sap-dev.example.com:8000
SAP_CLIENT=100

# --- 系统类型 ---
# onprem = On-Premise S/4HANA / ECC (BASIS >= 7.50)
SAP_SYSTEM_TYPE=onprem

# --- 认证: Basic Auth ---
SAP_AUTH_TYPE=basic
SAP_USERNAME=dev_user
SAP_PASSWORD=dev_password

# --- On-Premise 系统上下文 (Create/Update 必填) ---
SAP_MASTER_SYSTEM=DEV
# SAP_RESPONSIBLE=dev_user

# --- 可选 ---
# SAP_LANGUAGE=en
# TLS_REJECT_UNAUTHORIZED=0          # 自签名证书,仅开发环境!
# SAP_TIMEOUT_DEFAULT=45000
