# ============================================================================
# MCP ABAP ADT — PROD 系统环境文件模板 (ABAP Cloud / BTP + JWT 示例)
# 用法: 复制为 prod.env,填入你的生产系统信息。
#   copy prod.env.example prod.env   (Windows)
#   cp prod.env.example prod.env     (macOS / Linux)
# 注意: 本文件是占位值,直接使用无法连接 SAP。不要提交真实的 prod.env 到 git!
# ============================================================================

# --- SAP 系统连接 (必填) ---
# ABAP Cloud (BTP) 生产系统示例 (替换为你的真实 URL)
SAP_URL=https://your-prod.abap.example.com
SAP_CLIENT=100

# --- 系统类型 ---
# cloud = ABAP Cloud / BTP (默认)
SAP_SYSTEM_TYPE=cloud

# --- 认证: JWT / XSUAA ---
SAP_AUTH_TYPE=jwt
# 占位 token (带远期 exp,仅用于让服务器正常启动;替换为你的真实 JWT)
SAP_JWT_TOKEN=eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiJwcm9kIiwiZXhwIjo0MTAyNDQ0ODAwLCJpYXQiOjE3MDAwMDAwMDB9.placeholder

# UAA 凭据 (JWT 模式必填!)
# 注意: 即使已预置 SAP_JWT_TOKEN,服务器启动时 broker 初始化仍需要这三项
# (AuthorizationCodeProvider 校验),缺失会导致启动退回 inspection-only 模式。
SAP_UAA_URL=https://your-tenant.authentication.example.com
SAP_UAA_CLIENT_ID=your-client-id
SAP_UAA_CLIENT_SECRET=your-client-secret

# SAP_REFRESH_TOKEN=your_refresh_token_here        # 可选,自动续期

# --- 可选 ---
# SAP_LANGUAGE=en
# SAP_TIMEOUT_DEFAULT=45000

# --- 敏感表防护 (生产环境建议开启) ---
# SC4SAP_POLICY=on
# SC4SAP_POLICY_PROFILE=strict
